{
    "name": "@portable-agent/channel-gateway",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.19.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node dist/main.js",
        "generate": "openapi-typescript contracts/channel-gateway-api.yaml -o src/generated/channel-api.ts",
        "check:generated": "pnpm generate && git diff --exit-code -- src/generated/channel-api.ts",
        "lint": "pnpm check:generated && eslint . && prettier --check .",
        "format": "prettier --write .",
        "test": "pnpm generate && vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.test.json",
        "build": "pnpm typecheck && tsc -p tsconfig.json"
    },
    "dependencies": {
        "@fastify/helmet": "13.1.1",
        "fastify": "5.12.5",
        "jose": "6.2.12",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.1",
        "@vitest/coverage-v8": "5.0.1",
        "eslint": "10.10.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.7",
        "tsx": "4.23.13",
        "typescript": "7.0.2",
        "typescript-eslint": "8.70.0",
        "vitest": "5.0.1"
    }
}
